# ==============================================================================
# Database Configuration
# ==============================================================================
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/travel_planner?retryWrites=true&w=majority
# (Optional) Specific database name override
MONGODB_DB=travel_planner

# ==============================================================================
# Application & Domain URL
# ==============================================================================
# Base URL of Next.js frontend (used in CORS & email verification/reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Real-Time Chat Server Configuration
# ==============================================================================
# Port for chat-server.js (standalone express socket server)
PORT=3001
# Socket URL accessed by client browser
NEXT_PUBLIC_CHAT_SOCKET_URL=http://localhost:3001

# ==============================================================================
# Email Server Configuration (Nodemailer with Gmail)
# ==============================================================================
# Gmail address sending the OTP & password reset emails
EMAIL_SERVER_USER=your-email@gmail.com
# 16-character Google App Password (NOT your normal Gmail password)
EMAIL_SERVER_PASSWORD=your-gmail-app-password

# ==============================================================================
# AI Integration API Keys
# ==============================================================================
# Hugging Face Access Token for Mistral-7B suggestions (api/trips/suggestions)
HUGGINGFACE_API_KEY=hf_your_huggingface_token
# Google Gemini API key for trip recommendations (api/trips/recommendations)
GEMINI_API_KEY=AIza_your_gemini_api_key

# ==============================================================================
# Environment Mode
# ==============================================================================
NODE_ENV=development

# ==============================================================================
# Security & Cryptography
# ==============================================================================
# 256-bit secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ==============================================================================
# Media & Cloud Storage (Optional)
# ==============================================================================
# Cloudinary storage for profile photo uploads (falls back to local /public/uploads if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Observability & Logging (Optional)
# ==============================================================================
# Pino log level: 'debug' | 'info' | 'warn' | 'error' (defaults to 'debug' in dev, 'info' in prod)
LOG_LEVEL=info
